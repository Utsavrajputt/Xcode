<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window/splash theme; all real theming is Compose Material 3.
         "DayNight" isn't a platform (android:) theme, that's an AppCompat/
         Material Components concept and this app has neither dependency,
         so light/dark here is done the plain Android way: this file (light
         parent) plus a values-night/ override (dark parent), same style name. -->
    <style name="Theme.Xcode" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
