{
 "name": "eclipse-dark",
 "type": "dark",
 "colors": {
  "editor.background": "#2F2F2F",
  "editor.foreground": "#E6E6E6",
  "editor.selectionBackground": "#3A4A66",
  "editor.lineHighlightBackground": "#3A3A3A",
  "editorCursor.foreground": "#FFFFFF",
  "editorLineNumber.foreground": "#787878",
  "editorLineNumber.activeForeground": "#E6E6E6",
  "editorWhitespace.foreground": "#454545",
  "editorIndentGuide.background": "#454545"
 },
 "settings": [
  {
   "settings": {
    "foreground": "#E6E6E6",
    "background": "#2F2F2F"
   }
  },
  {
   "settings": {
    "foreground": "#6E9F82",
    "fontStyle": "italic"
   },
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ]
  },
  {
   "settings": {
    "foreground": "#6E9F82"
   },
   "scope": [
    "comment.line.shebang"
   ]
  },
  {
   "settings": {
    "foreground": "#8CB4FF"
   },
   "scope": [
    "string",
    "string.quoted",
    "string.template"
   ]
  },
  {
   "settings": {
    "foreground": "#B8D3FF"
   },
   "scope": [
    "constant.character.escape",
    "constant.character.entity",
    "constant.other.placeholder"
   ]
  },
  {
   "settings": {
    "foreground": "#9BD1FF"
   },
   "scope": [
    "constant.numeric",
    "constant.other.datetime"
   ]
  },
  {
   "settings": {
    "foreground": "#9BD1FF"
   },
   "scope": [
    "constant.language",
    "constant.other.color"
   ]
  },
  {
   "settings": {
    "foreground": "#D896C8"
   },
   "scope": [
    "keyword",
    "keyword.control",
    "storage",
    "storage.type",
    "storage.modifier"
   ]
  },
  {
   "settings": {
    "foreground": "#E6E6E6"
   },
   "scope": [
    "keyword.operator",
    "punctuation.separator",
    "punctuation.definition.tag"
   ]
  },
  {
   "settings": {
    "foreground": "#E6E6E6"
   },
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call"
   ]
  },
  {
   "settings": {
    "foreground": "#C6C6FF"
   },
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.class",
    "storage.type.primitive"
   ]
  },
  {
   "settings": {
    "foreground": "#B8B8B8"
   },
   "scope": [
    "storage.type.annotation",
    "meta.preprocessor",
    "keyword.other.important",
    "variable.other.anchor",
    "storage.type.tag"
   ]
  },
  {
   "settings": {
    "foreground": "#9BD1FF"
   },
   "scope": [
    "variable.language",
    "variable.other.template",
    "variable.other.format",
    "variable.css"
   ]
  },
  {
   "settings": {
    "foreground": "#E6E6E6"
   },
   "scope": [
    "variable.other",
    "variable.parameter"
   ]
  },
  {
   "settings": {
    "foreground": "#D896C8"
   },
   "scope": [
    "entity.name.tag",
    "entity.name.section",
    "keyword.control.at-rule"
   ]
  },
  {
   "settings": {
    "foreground": "#C6C6FF"
   },
   "scope": [
    "entity.other.attribute-name",
    "support.type.property-name",
