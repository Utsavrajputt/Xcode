   ]
  },
  {
   "settings": {
    "foreground": "#8CB4FF",
    "fontStyle": "underline"
   },
   "scope": [
    "markup.underline.link"
   ]
  },
  {
   "settings": {
    "foreground": "#6E9F82",
    "fontStyle": "italic"
   },
   "scope": [
    "markup.quote"
   ]
  },
  {
   "settings": {
    "foreground": "#D896C8"
   },
   "scope": [
    "punctuation.definition.list",
    "meta.separator"
   ]
  }
 ]
}