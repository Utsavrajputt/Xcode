    "markup.bold"
   ]
  },
  {
   "settings": {
    "foreground": "#E6E6E6",
    "fontStyle": "italic"
   },
   "scope": [
    "markup.italic"
   ]
  },
  {
   "settings": {
    "foreground": "#6E9F82",
    "fontStyle": "strikethrough"
   },
   "scope": [
    "markup.strikethrough"
   ]
  },
  {
   "settings": {
    "foreground": "#8CB4FF"
   },
   "scope": [
    "markup.inline.raw",
