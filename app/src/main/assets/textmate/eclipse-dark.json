    "foreground": "#B8B8B8"
   },
   "scope": [
    "entity.name.label",
    "keyword.control.directive"
   ]
  },
  {
   "settings": {
    "foreground": "#9BD1FF"
   },
   "scope": [
    "support.constant"
   ]
  },
  {
   "settings": {
    "foreground": "#D896C8",
    "fontStyle": "bold"
   },
