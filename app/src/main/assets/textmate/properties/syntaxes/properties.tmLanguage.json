{
 "name": "Properties",
 "scopeName": "source.properties",
 "patterns": [
  {
   "name": "comment.line.properties",
   "match": "^\\s*[#!].*$"
  },
  {
   "match": "^\\s*((?:[^\\s#!=:\\\\]|\\\\.)(?:[^\\s=:\\\\]|\\\\.)*)\\s*([=:])?\\s*(.*)$",
   "captures": {
    "1": {
     "name": "support.type.property-name.properties"
    },
    "2": {
     "name": "punctuation.separator.key-value.properties"
    },
    "3": {
     "name": "string.unquoted.properties"
    }
   }
  }
 ]
}
