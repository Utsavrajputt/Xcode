{
 "name": "eclipse",
 "type": "light",
 "colors": {
  "editor.background": "#FFFFFF",
  "editor.foreground": "#000000",
  "editor.selectionBackground": "#C0C0C0",
  "editor.lineHighlightBackground": "#F0F0F0",
  "editorCursor.foreground": "#000000",
  "editorLineNumber.foreground": "#999999",
  "editorLineNumber.activeForeground": "#333333",
  "editorWhitespace.foreground": "#CCCCCC",
  "editorIndentGuide.background": "#D8D8D8"
 },
 "settings": [
  {
   "settings": {
    "foreground": "#000000",
    "background": "#FFFFFF"
   }
  },
  {
   "settings": {
    "fontStyle": "italic",
    "foreground": "#3F7F5F"
   },
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ]
  },
  {
   "settings": {
    "foreground": "#3F7F5F"
   },
   "scope": [
    "comment.line.shebang"
   ]
  },
  {
   "settings": {
    "foreground": "#2A00FF"
   },
   "scope": [
    "string",
    "string.quoted",
    "string.template"
   ]
  },
  {
   "settings": {
    "foreground": "#7F7F9F"
   },
   "scope": [
    "constant.character.escape",
    "constant.character.entity",
    "constant.other.placeholder"
   ]
  },
  {
   "settings": {
    "foreground": "#000000"
   },
   "scope": [
    "constant.numeric",
    "constant.other.datetime"
   ]
  },
  {
   "settings": {
    "foreground": "#7F0055"
   },
   "scope": [
    "constant.language",
    "constant.other.color"
   ]
  },
  {
   "settings": {
    "foreground": "#7F0055"
   },
   "scope": [
    "keyword",
    "keyword.control",
    "storage",
    "storage.type",
    "storage.modifier"
   ]
  },
  {
   "settings": {
    "foreground": "#000000"
   },
   "scope": [
    "keyword.operator",
    "punctuation.separator",
    "punctuation.definition.tag"
   ]
  },
  {
   "settings": {
    "foreground": "#000000"
   },
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call"
   ]
  },
  {
   "settings": {
    "foreground": "#000000"
   },
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.class",
    "storage.type.primitive"
   ]
  },
  {
   "settings": {
    "foreground": "#646464"
   },
   "scope": [
    "storage.type.annotation",
    "meta.preprocessor",
    "keyword.other.important",
    "variable.other.anchor",
    "storage.type.tag"
   ]
  },
  {
   "settings": {
    "foreground": "#7F0055"
   },
   "scope": [
    "variable.language",
    "variable.other.template",
    "variable.other.format",
    "variable.css"
   ]
  },
  {
   "settings": {
    "foreground": "#000000"
   },
   "scope": [
    "variable.other",
    "variable.parameter"
   ]
  },
  {
   "settings": {
    "foreground": "#3F7F7F"
   },
   "scope": [
    "entity.name.tag",
    "entity.name.section",
    "keyword.control.at-rule"
   ]
  },
  {
   "settings": {
    "foreground": "#7F007F"
   },
   "scope": [
    "entity.other.attribute-name",
    "support.type.property-name",
