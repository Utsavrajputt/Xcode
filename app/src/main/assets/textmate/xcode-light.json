{
 "name": "xcode-light",
 "type": "light",
 "colors": {
  "editor.background": "#FFFFFF",
  "editor.foreground": "#24292E",
  "editor.selectionBackground": "#B6D6FD",
  "editor.lineHighlightBackground": "#F4F6F8",
  "editorCursor.foreground": "#0969DA",
  "editorLineNumber.foreground": "#8C959F",
  "editorLineNumber.activeForeground": "#24292E",
  "editorWhitespace.foreground": "#D0D7DE",
  "editorIndentGuide.background": "#E4E8EC"
 },
 "settings": [
  {
   "settings": {
    "foreground": "#24292E",
    "background": "#FFFFFF"
   }
  },
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#6A737D",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "comment.line.shebang"
   ],
   "settings": {
    "foreground": "#6A737D"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted",
    "string.template"
   ],
   "settings": {
    "foreground": "#0A7B3A"
   }
  },
  {
   "scope": [
    "constant.character.escape",
    "constant.character.entity",
    "constant.other.placeholder"
   ],
   "settings": {
    "foreground": "#0550AE"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "constant.other.datetime"
   ],
   "settings": {
    "foreground": "#0550AE"
   }
  },
  {
   "scope": [
    "constant.language",
    "constant.other.color"
   ],
   "settings": {
    "foreground": "#953800"
   }
  },
  {
   "scope": [
    "keyword",
    "keyword.control",
    "storage",
    "storage.type",
    "storage.modifier"
   ],
   "settings": {
    "foreground": "#CF222E"
   }
  },
  {
   "scope": [
    "keyword.operator",
    "punctuation.separator",
    "punctuation.definition.tag"
   ],
   "settings": {
    "foreground": "#57606A"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call"
   ],
   "settings": {
    "foreground": "#6639BA"
   }
  },
  {
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.class",
    "storage.type.primitive"
   ],
   "settings": {
    "foreground": "#0A6FB4"
   }
  },
  {
   "scope": [
    "storage.type.annotation",
    "meta.preprocessor",
    "keyword.other.important",
    "variable.other.anchor",
    "storage.type.tag"
   ],
   "settings": {
    "foreground": "#9A6700"
   }
  },
  {
   "scope": [
    "variable.language",
    "variable.other.template",
    "variable.other.format",
    "variable.css"
   ],
   "settings": {
    "foreground": "#953800"
   }
  },
  {
   "scope": [
    "variable.other",
    "variable.parameter"
   ],
   "settings": {
    "foreground": "#24292E"
   }
  },
  {
   "scope": [
    "entity.name.tag",
    "entity.name.section",
    "keyword.control.at-rule"
   ],
   "settings": {
    "foreground": "#116329"
   }
  },
  {
   "scope": [
    "entity.other.attribute-name",
    "support.type.property-name",
    "variable.parameter.option"
   ],
   "settings": {
    "foreground": "#0550AE"
   }
  },
  {
   "scope": [
    "entity.name.label",
    "keyword.control.directive"
   ],
   "settings": {
    "foreground": "#8250DF"
   }
  },
  {
   "scope": [
    "support.constant"
   ],
   "settings": {
    "foreground": "#953800"
   }
  },
  {
   "scope": [
    "markup.heading",
    "markup.heading.setext"
   ],
   "settings": {
    "foreground": "#116329",
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.bold"
   ],
   "settings": {
    "foreground": "#24292E",
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.italic"
   ],
   "settings": {
    "foreground": "#24292E",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "markup.strikethrough"
   ],
   "settings": {
    "foreground": "#6A737D",
    "fontStyle": "strikethrough"
   }
  },
  {
   "scope": [
    "markup.inline.raw",
    "markup.fenced_code"
   ],
   "settings": {
    "foreground": "#0A7B3A"
   }
  },
  {
   "scope": [
    "markup.underline.link"
   ],
   "settings": {
    "foreground": "#0969DA",
    "fontStyle": "underline"
   }
  },
  {
   "scope": [
    "markup.quote"
   ],
   "settings": {
    "foreground": "#6A737D",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "punctuation.definition.list",
    "meta.separator"
   ],
   "settings": {
    "foreground": "#CF222E"
   }
  }
 ],
