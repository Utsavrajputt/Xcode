{
 "name": "TOML",
 "scopeName": "source.toml",
 "patterns": [
  {
   "name": "comment.line.number-sign.toml",
   "match": "#.*$"
  },
  {
   "name": "entity.name.section.toml",
   "match": "^\\s*\\[\\[?[^\\]\\n]+\\]\\]?"
  },
  {
   "name": "support.type.property-name.toml",
   "match": "^\\s*(?:[\\w-]+|\\\"[^\\\"\\n]*\\\"|'[^'\\n]*')(?:\\s*\\.\\s*(?:[\\w-]+|\\\"[^\\\"\\n]*\\\"|'[^'\\n]*'))*(?=\\s*=)"
  },
  {
   "name": "string.quoted.triple.toml",
   "begin": "\"\"\"",
   "end": "\"\"\"",
   "patterns": [
    {
     "name": "constant.character.escape",
     "match": "\\\\(?:u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
    }
   ]
  },
  {
   "name": "string.quoted.triple.toml",
   "begin": "'''",
   "end": "'''"
  },
  {
   "name": "string.quoted.double.toml",
   "begin": "\"",
   "end": "(\")|$",
   "patterns": [
    {
     "name": "constant.character.escape",
     "match": "\\\\(?:u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
    }
   ]
  },
  {
   "name": "string.quoted.single.toml",
   "begin": "'",
   "end": "(')|$"
  },
  {
   "name": "constant.other.datetime.toml",
   "match": "\\b\\d{4}-\\d{2}-\\d{2}(?:[Tt ]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})?)?\\b"
  },
  {
   "name": "constant.language.toml",
   "match": "\\b(?:true|false|inf|nan)\\b"
  },
  {
   "name": "constant.numeric.toml",
   "match": "[+-]?\\b(?:0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)\\b"
  }
 ]
}
