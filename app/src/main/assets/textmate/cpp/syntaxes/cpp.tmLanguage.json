{
 "name": "C++",
 "scopeName": "source.cpp",
 "patterns": [
  {
   "name": "comment.block.cpp",
   "begin": "/\\*",
   "end": "\\*/"
  },
  {
   "name": "comment.line.cpp",
   "match": "//.*$"
  },
  {
   "match": "^\\s*(#)\\s*(include|import)\\s*(<[^>\\n]*>|\\\"[^\\\"\\n]*\\\")?",
   "captures": {
    "1": {
     "name": "meta.preprocessor"
    },
    "2": {
     "name": "meta.preprocessor.include"
    },
    "3": {
     "name": "string.quoted.other.lt-gt.include"
    }
   }
  },
  {
   "name": "meta.preprocessor.cpp",
   "match": "^\\s*#\\s*\\w+"
  },
  {
   "name": "string.quoted.double.cpp",
   "begin": "\"",
   "end": "(\")|(?<!\\\\)$",
   "patterns": [
    {
     "name": "constant.character.escape",
     "match": "\\\\(?:u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
    },
    {
     "name": "constant.other.placeholder",
     "match": "%[-+ #0]*\\d*(?:\\.\\d+)?[hlLzjt]*[diouxXeEfFgGaAcspn%]"
    }
   ]
  },
  {
   "name": "string.quoted.single.cpp",
   "match": "'(?:\\\\.|[^'\\\\])'"
  },
  {
   "name": "keyword.control.cpp",
   "match": "\\b(?:if|else|switch|case|default|for|while|do|return|break|continue|goto|sizeof|typedef|try|catch|throw|co_await|co_return|co_yield)\\b"
  },
  {
   "name": "storage.type.cpp",
   "match": "\\b(?:void|char|short|int|long|float|double|signed|unsigned|bool|size_t|ssize_t|int8_t|int16_t|int32_t|int64_t|uint8_t|uint16_t|uint32_t|uint64_t|wchar_t)\\b"
  },
  {
   "name": "storage.modifier.cpp",
   "match": "\\b(?:static|const|volatile|extern|register|inline|restrict|struct|union|enum|virtual|override|final|explicit|friend|constexpr|noexcept|mutable|public|private|protected|class|namespace|template|typename|using|operator|concept|requires|export)\\b"
  },
  {
   "name": "constant.language.cpp",
   "match": "\\b(?:NULL|true|false|nullptr)\\b"
  },
  {
   "name": "variable.language.cpp",
   "match": "\\b(?:this)\\b"
  },
  {
   "name": "support.class.std.cpp",
   "match": "\\bstd(?=::)"
  },
  {
   "match": "\\b(class|struct|namespace|enum)\\s+([A-Za-z_]\\w*)",
   "captures": {
    "1": {
     "name": "storage.type.cpp"
    },
    "2": {
     "name": "entity.name.type.cpp"
    }
   }
  },
  {
   "name": "constant.numeric.cpp",
   "match": "(?<![\\w.$])(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)[fFdDlLuUnN]*\\b"
  },
  {
   "name": "entity.name.function.cpp",
   "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"
  },
  {
   "name": "entity.name.type.cpp",
   "match": "\\b[A-Z][A-Z0-9_]*[a-z]\\w*\\b"
  }
 ]
}
