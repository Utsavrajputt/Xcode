{
 "name": "XML",
 "scopeName": "text.xml",
 "patterns": [
  {
   "name": "comment.block.xml",
   "begin": "<!--",
   "end": "-->"
  },
  {
   "name": "meta.cdata.xml",
   "begin": "<!\\[CDATA\\[",
   "end": "\\]\\]>"
  },
  {
   "name": "meta.preprocessor.xml",
   "begin": "<\\?",
   "end": "\\?>",
   "patterns": [
    {
     "include": "#attrs"
    }
   ]
  },
  {
   "name": "meta.doctype.xml",
   "match": "<!DOCTYPE[^>]*>"
  },
  {
   "begin": "(</?)([\\w:.-]+)",
   "end": "(/?>)",
   "beginCaptures": {
    "1": {
     "name": "punctuation.definition.tag"
    },
    "2": {
     "name": "entity.name.tag"
    }
   },
   "endCaptures": {
    "1": {
     "name": "punctuation.definition.tag"
    }
   },
   "patterns": [
    {
     "include": "#attrs"
    }
   ]
  },
  {
   "name": "constant.character.entity",
   "match": "&[\\w#]+;"
  }
 ],
 "repository": {
  "attrs": {
   "patterns": [
    {
     "name": "string.quoted.double.xml",
     "begin": "\"",
     "end": "\"",
     "patterns": [
      {
       "name": "constant.character.entity",
       "match": "&[\\w#]+;"
      }
     ]
    },
    {
     "name": "string.quoted.single.xml",
     "begin": "'",
     "end": "'",
     "patterns": [
      {
       "name": "constant.character.entity",
       "match": "&[\\w#]+;"
      }
     ]
    },
    {
     "name": "entity.other.attribute-name",
     "match": "[A-Za-z_:@][\\w:.@-]*"
    },
    {
     "name": "punctuation.separator.key-value",
     "match": "="
    }
   ]
  }
 }
}
