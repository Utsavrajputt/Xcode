{
 "name": "Dart",
 "scopeName": "source.dart",
 "patterns": [
  {
   "name": "comment.block.dart",
   "begin": "/\\*",
   "end": "\\*/"
  },
  {
   "name": "comment.line.dart",
   "match": "//.*$"
  },
  {
   "name": "string.quoted.triple.dart",
   "begin": "[rR]?'''",
   "end": "'''",
   "patterns": [
    {
     "name": "constant.character.escape",
     "match": "\\\\(?:u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
    },
    {
     "name": "variable.other.template",
     "match": "\\$[A-Za-z_]\\w*"
    },
    {
     "name": "meta.template.expression",
     "begin": "\\$\\{",
     "end": "\\}",
     "patterns": [
      {
       "include": "$self"
      }
     ]
    }
   ]
  },
  {
   "name": "string.quoted.triple.dart",
   "begin": "[rR]?\"\"\"",
   "end": "\"\"\"",
   "patterns": [
    {
     "name": "constant.character.escape",
     "match": "\\\\(?:u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
    },
    {
     "name": "variable.other.template",
     "match": "\\$[A-Za-z_]\\w*"
    },
    {
     "name": "meta.template.expression",
     "begin": "\\$\\{",
     "end": "\\}",
     "patterns": [
      {
       "include": "$self"
      }
     ]
    }
   ]
  },
  {
   "name": "string.quoted.double.dart",
   "begin": "[rR]?\"",
   "end": "(\")|$",
   "patterns": [
    {
     "name": "constant.character.escape",
     "match": "\\\\(?:u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
    },
    {
     "name": "variable.other.template",
     "match": "\\$[A-Za-z_]\\w*"
    },
    {
     "name": "meta.template.expression",
     "begin": "\\$\\{",
     "end": "\\}",
     "patterns": [
      {
       "include": "$self"
      }
     ]
    }
   ]
  },
  {
   "name": "string.quoted.single.dart",
   "begin": "[rR]?'",
   "end": "(')|$",
   "patterns": [
    {
     "name": "constant.character.escape",
     "match": "\\\\(?:u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
    },
    {
     "name": "variable.other.template",
     "match": "\\$[A-Za-z_]\\w*"
    },
    {
     "name": "meta.template.expression",
     "begin": "\\$\\{",
     "end": "\\}",
     "patterns": [
      {
       "include": "$self"
      }
     ]
    }
   ]
  },
  {
   "name": "storage.type.annotation.dart",
   "match": "@[A-Za-z_][\\w.]*"
  },
  {
   "match": "\\b(class|mixin|enum|extension|typedef)\\s+([A-Za-z_$][\\w$]*)",
   "captures": {
    "1": {
     "name": "storage.type.dart"
    },
    "2": {
     "name": "entity.name.type.dart"
    }
   }
  },
  {
   "name": "keyword.control.dart",
   "match": "\\b(?:if|else|switch|case|default|for|while|do|return|break|continue|throw|try|catch|finally|rethrow|assert|await|yield|in|is|as|on)\\b"
  },
  {
   "name": "storage.type.dart",
   "match": "\\b(?:class|mixin|enum|extension|typedef|extends|implements|with|import|export|library|part|show|hide|var|final|const|late|dynamic|void|int|double|num|bool|String|List|Map|Set|Future|Stream|Object|Function)\\b"
  },
  {
   "name": "storage.modifier.dart",
   "match": "\\b(?:static|abstract|external|factory|covariant|required|async|sync|operator|get|set|base|sealed|interface)\\b"
  },
  {
   "name": "constant.language.dart",
   "match": "\\b(?:true|false|null)\\b"
  },
  {
   "name": "variable.language.dart",
   "match": "\\b(?:this|super)\\b"
  },
  {
   "name": "constant.numeric.dart",
   "match": "(?<![\\w.$])(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)[fFdDlLuUnN]*\\b"
  },
  {
   "name": "entity.name.type.dart",
   "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
  },
  {
   "name": "entity.name.function.dart",
   "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"
  }
 ]
}
