{
 "name": "vscode-dark",
 "type": "dark",
 "colors": {
  "editor.background": "#1E1E1E",
  "editor.foreground": "#D4D4D4",
  "editor.selectionBackground": "#264F78",
  "editor.lineHighlightBackground": "#2A2D2E",
  "editorCursor.foreground": "#AEAFAD",
  "editorLineNumber.foreground": "#858585",
  "editorLineNumber.activeForeground": "#C6C6C6",
  "editorWhitespace.foreground": "#3B3A32",
  "editorIndentGuide.background": "#404040"
 },
 "settings": [
  {
   "settings": {
    "foreground": "#D4D4D4",
    "background": "#1E1E1E"
   }
  },
  {
   "settings": {
    "fontStyle": "italic",
    "foreground": "#6A9955"
   },
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ]
  },
  {
   "settings": {
    "foreground": "#6A9955"
   },
   "scope": [
    "comment.line.shebang"
   ]
  },
  {
   "settings": {
    "foreground": "#CE9178"
   },
   "scope": [
    "string",
    "string.quoted",
    "string.template"
   ]
  },
  {
   "settings": {
    "foreground": "#D7BA7D"
   },
   "scope": [
    "constant.character.escape",
    "constant.character.entity",
    "constant.other.placeholder"
   ]
  },
  {
   "settings": {
    "foreground": "#B5CEA8"
   },
   "scope": [
    "constant.numeric",
    "constant.other.datetime"
   ]
  },
  {
   "settings": {
    "foreground": "#569CD6"
   },
   "scope": [
    "constant.language",
    "constant.other.color"
   ]
  },
  {
   "settings": {
    "foreground": "#569CD6"
   },
   "scope": [
    "keyword",
    "keyword.control",
    "storage",
    "storage.type",
    "storage.modifier"
   ]
  },
  {
   "settings": {
    "foreground": "#D4D4D4"
   },
   "scope": [
    "keyword.operator",
    "punctuation.separator",
    "punctuation.definition.tag"
   ]
  },
  {
   "settings": {
    "foreground": "#DCDCAA"
   },
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call"
   ]
  },
  {
   "settings": {
    "foreground": "#4EC9B0"
   },
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.class",
    "storage.type.primitive"
   ]
  },
  {
   "settings": {
    "foreground": "#DCDCAA"
   },
   "scope": [
    "storage.type.annotation",
    "meta.preprocessor",
    "keyword.other.important",
    "variable.other.anchor",
    "storage.type.tag"
   ]
  },
  {
   "settings": {
    "foreground": "#569CD6"
   },
   "scope": [
    "variable.language",
    "variable.other.template",
    "variable.other.format",
    "variable.css"
   ]
  },
  {
   "settings": {
    "foreground": "#9CDCFE"
   },
   "scope": [
    "variable.other",
    "variable.parameter"
   ]
  },
  {
   "settings": {
    "foreground": "#569CD6"
   },
   "scope": [
    "entity.name.tag",
    "entity.name.section",
    "keyword.control.at-rule"
   ]
  },
  {
   "settings": {
    "foreground": "#9CDCFE"
   },
   "scope": [
    "entity.other.attribute-name",
    "support.type.property-name",
    "variable.parameter.option"
   ]
  },
  {
   "settings": {
    "foreground": "#DCDCAA"
   },
   "scope": [
    "entity.name.label",
    "keyword.control.directive"
   ]
  },
  {
   "settings": {
    "foreground": "#4FC1FF"
   },
   "scope": [
    "support.constant"
   ]
  },
  {
   "settings": {
    "fontStyle": "bold",
    "foreground": "#569CD6"
   },
   "scope": [
    "markup.heading",
    "markup.heading.setext"
   ]
  },
  {
   "settings": {
    "fontStyle": "bold",
    "foreground": "#D4D4D4"
   },
   "scope": [
    "markup.bold"
   ]
  },
  {
   "settings": {
    "fontStyle": "italic",
    "foreground": "#D4D4D4"
   },
   "scope": [
    "markup.italic"
   ]
  },
  {
   "settings": {
    "fontStyle": "strikethrough",
    "foreground": "#6A9955"
   },
   "scope": [
    "markup.strikethrough"
   ]
  },
  {
   "settings": {
    "foreground": "#CE9178"
   },
   "scope": [
    "markup.inline.raw",
    "markup.fenced_code"
   ]
  },
  {
   "settings": {
    "fontStyle": "underline",
    "foreground": "#3794FF"
   },
   "scope": [
    "markup.underline.link"
   ]
  },
  {
   "settings": {
    "fontStyle": "italic",
    "foreground": "#6A9955"
   },
   "scope": [
    "markup.quote"
   ]
  },
  {
   "settings": {
    "foreground": "#569CD6"
   },
   "scope": [
    "punctuation.definition.list",
    "meta.separator"
   ]
  }
 ],
