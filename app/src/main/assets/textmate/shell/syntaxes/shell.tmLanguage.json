{
 "name": "Shell",
 "scopeName": "source.shell",
 "patterns": [
  {
   "name": "comment.line.shebang.shell",
   "match": "\\A#!.*$"
  },
  {
   "name": "comment.line.number-sign.shell",
   "match": "(?<![$\\w\\\\])#.*$"
  },
  {
   "name": "string.quoted.double.shell",
   "begin": "\"",
   "end": "\"",
   "patterns": [
    {
     "name": "constant.character.escape",
     "match": "\\\\(?:u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
    },
    {
     "name": "variable.other.shell",
     "match": "\\$(?:\\{[^}\\n]*\\}|[A-Za-z_]\\w*|[@#?*!$0-9-])"
    },
    {
     "name": "meta.subshell.shell",
     "begin": "\\$\\(",
     "end": "\\)",
     "patterns": [
      {
       "include": "$self"
      }
     ]
    },
    {
     "name": "string.interpolated.backtick.shell",
     "match": "`[^`\\n]*`"
    }
   ]
  },
  {
   "name": "string.quoted.single.shell",
   "begin": "'",
   "end": "'"
  },
  {
   "name": "variable.other.shell",
   "match": "\\$(?:\\{[^}\\n]*\\}|[A-Za-z_]\\w*|[@#?*!$0-9-])"
  },
  {
   "name": "meta.subshell.shell",
   "begin": "\\$\\(",
   "end": "\\)",
   "patterns": [
    {
     "include": "$self"
    }
   ]
  },
  {
   "name": "string.interpolated.backtick.shell",
   "match": "`[^`\\n]*`"
  },
  {
   "match": "\\b(function)\\s+([\\w:-]+)|^\\s*([\\w:-]+)\\s*(?=\\(\\)\\s*\\{?)",
   "captures": {
    "1": {
     "name": "storage.type.function.shell"
    },
    "2": {
     "name": "entity.name.function.shell"
    },
    "3": {
     "name": "entity.name.function.shell"
    }
   }
  },
  {
   "name": "keyword.control.shell",
   "match": "\\b(?:if|then|else|elif|fi|for|while|until|do|done|case|esac|in|select|return|exit|break|continue)\\b"
  },
  {
   "name": "storage.type.shell",
   "match": "\\b(?:function|local|export|readonly|declare|typeset|unset)\\b"
  },
  {
   "name": "support.function.builtin.shell",
   "match": "(?<![\\w.-])(?:echo|printf|cd|pwd|ls|cat|cp|mv|rm|mkdir|rmdir|touch|chmod|chown|grep|sed|awk|find|sort|uniq|head|tail|wc|cut|tr|xargs|tee|test|source|alias|set|shift|eval|exec|trap|read|wait|kill|sleep|true|false|git|curl|wget|tar|zip|unzip|pkg|apt|sudo)(?![\\w.-])"
  },
  {
   "name": "keyword.operator.shell",
   "match": "&&|\\|\\||[|&;<>]+|\\[\\[|\\]\\]|!"
  },
  {
   "name": "constant.numeric.shell",
   "match": "(?<![\\w.-])\\d+(?![\\w.-])"
  },
  {
   "name": "variable.parameter.option.shell",
   "match": "(?<=\\s)--?[A-Za-z][\\w-]*"
  }
 ]
}
