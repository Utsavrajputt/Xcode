{
 "name": "github-light",
 "type": "light",
 "colors": {
  "editor.background": "#FFFFFF",
  "editor.foreground": "#24292E",
  "editor.selectionBackground": "#C8E1FF",
  "editor.lineHighlightBackground": "#F6F8FA",
  "editorCursor.foreground": "#24292E",
  "editorLineNumber.foreground": "#1B1F234D",
  "editorLineNumber.activeForeground": "#24292E",
  "editorWhitespace.foreground": "#D1D5DA",
  "editorIndentGuide.background": "#EEEEEE"
 },
 "settings": [
  {
   "settings": {
    "foreground": "#24292E",
    "background": "#FFFFFF"
   }
  },
  {
   "settings": {
    "fontStyle": "italic",
    "foreground": "#6A737D"
   },
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ]
  },
  {
   "settings": {
    "foreground": "#6A737D"
   },
   "scope": [
    "comment.line.shebang"
   ]
  },
  {
   "settings": {
    "foreground": "#032F62"
   },
   "scope": [
    "string",
    "string.quoted",
    "string.template"
   ]
  },
  {
   "settings": {
    "foreground": "#005CC5"
   },
   "scope": [
    "constant.character.escape",
    "constant.character.entity",
    "constant.other.placeholder"
   ]
  },
  {
   "settings": {
    "foreground": "#005CC5"
   },
   "scope": [
    "constant.numeric",
    "constant.other.datetime"
   ]
  },
  {
   "settings": {
    "foreground": "#005CC5"
   },
   "scope": [
    "constant.language",
    "constant.other.color"
   ]
  },
  {
   "settings": {
    "foreground": "#D73A49"
   },
   "scope": [
    "keyword",
    "keyword.control",
    "storage",
    "storage.type",
    "storage.modifier"
   ]
  },
  {
   "settings": {
    "foreground": "#24292E"
   },
   "scope": [
    "keyword.operator",
    "punctuation.separator",
    "punctuation.definition.tag"
   ]
  },
  {
   "settings": {
    "foreground": "#6F42C1"
   },
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call"
   ]
  },
  {
   "settings": {
    "foreground": "#22863A"
   },
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.class",
    "storage.type.primitive"
   ]
  },
  {
   "settings": {
    "foreground": "#E36209"
   },
   "scope": [
    "storage.type.annotation",
    "meta.preprocessor",
    "keyword.other.important",
    "variable.other.anchor",
    "storage.type.tag"
   ]
  },
  {
   "settings": {
    "foreground": "#005CC5"
   },
   "scope": [
    "variable.language",
    "variable.other.template",
    "variable.other.format",
    "variable.css"
   ]
  },
  {
   "settings": {
    "foreground": "#24292E"
   },
   "scope": [
    "variable.other",
    "variable.parameter"
   ]
  },
  {
   "settings": {
    "foreground": "#22863A"
   },
   "scope": [
    "entity.name.tag",
    "entity.name.section",
    "keyword.control.at-rule"
   ]
  },
  {
   "settings": {
    "foreground": "#6F42C1"
   },
   "scope": [
    "entity.other.attribute-name",
    "support.type.property-name",
    "variable.parameter.option"
   ]
  },
  {
   "settings": {
    "foreground": "#6F42C1"
   },
   "scope": [
    "entity.name.label",
    "keyword.control.directive"
   ]
  },
  {
   "settings": {
    "foreground": "#005CC5"
   },
   "scope": [
    "support.constant"
   ]
  },
  {
   "settings": {
    "fontStyle": "bold",
    "foreground": "#22863A"
   },
   "scope": [
    "markup.heading",
    "markup.heading.setext"
   ]
  },
  {
   "settings": {
    "fontStyle": "bold",
    "foreground": "#24292E"
   },
   "scope": [
    "markup.bold"
   ]
  },
  {
   "settings": {
