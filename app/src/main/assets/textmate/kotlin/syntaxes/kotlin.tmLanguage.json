{
 "name": "Kotlin",
 "scopeName": "source.kotlin",
 "patterns": [
  {
   "name": "comment.block.kotlin",
   "begin": "/\\*",
   "end": "\\*/"
  },
  {
   "name": "comment.line.kotlin",
   "match": "//.*$"
  },
  {
   "name": "string.quoted.triple.kotlin",
   "begin": "\"\"\"",
   "end": "\"\"\"",
   "patterns": [
    {
     "name": "variable.other.template",
     "match": "\\$[A-Za-z_]\\w*"
    },
    {
     "name": "meta.template.expression",
     "begin": "\\$\\{",
     "end": "\\}",
     "patterns": [
      {
       "include": "$self"
      }
     ]
    }
   ]
  },
  {
   "name": "string.quoted.double.kotlin",
   "begin": "\"",
   "end": "(\")|$",
   "patterns": [
    {
     "name": "constant.character.escape",
     "match": "\\\\(?:u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
    },
    {
     "name": "variable.other.template",
     "match": "\\$[A-Za-z_]\\w*"
    },
    {
     "name": "meta.template.expression",
     "begin": "\\$\\{",
     "end": "\\}",
     "patterns": [
      {
       "include": "$self"
      }
     ]
    }
   ]
  },
  {
   "name": "string.quoted.single.kotlin",
   "match": "'(?:\\\\.|[^'\\\\])'"
  },
  {
   "name": "storage.type.annotation.kotlin",
   "match": "@[A-Za-z_][\\w.]*(?::[A-Za-z_][\\w.]*)?"
  },
  {
   "match": "\\b(class|interface|object|typealias)\\s+([A-Za-z_$][\\w$]*)",
   "captures": {
    "1": {
     "name": "storage.type.kotlin"
    },
    "2": {
     "name": "entity.name.type.kotlin"
    }
   }
  },
  {
   "match": "\\b(fun)\\s+(?:<[^>]*>\\s*)?(?:[\\w]+(?:<[^>]*>)?\\??\\.)*([A-Za-z_]\\w*)",
   "captures": {
    "1": {
     "name": "storage.type.function.kotlin"
    },
    "2": {
     "name": "entity.name.function.kotlin"
    }
   }
  },
  {
   "name": "keyword.control.kotlin",
   "match": "\\b(?:if|else|when|for|while|do|return|break|continue|throw|try|catch|finally|in|is|as|by|where)\\b"
  },
  {
   "name": "storage.type.kotlin",
   "match": "\\b(?:class|interface|object|fun|val|var|typealias|package|import|constructor|init|companion|get|set)\\b"
  },
  {
   "name": "storage.modifier.kotlin",
   "match": "\\b(?:public|private|protected|internal|open|abstract|final|override|sealed|data|inner|enum|annotation|lateinit|const|suspend|inline|noinline|crossinline|reified|vararg|tailrec|operator|infix|external|actual|expect|value|out)\\b"
  },
  {
   "name": "constant.language.kotlin",
   "match": "\\b(?:true|false|null)\\b"
  },
  {
   "name": "variable.language.kotlin",
   "match": "\\b(?:this|super|it)\\b"
  },
  {
   "name": "constant.numeric.kotlin",
   "match": "(?<![\\w.$])(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)[fFdDlLuUnN]*\\b"
  },
  {
   "name": "entity.name.type.kotlin",
   "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
  },
  {
   "name": "entity.name.function.kotlin",
   "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"
  }
 ]
}
