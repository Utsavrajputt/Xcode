{
 "name": "vscode-light",
 "type": "light",
 "colors": {
  "editor.background": "#FFFFFF",
  "editor.foreground": "#000000",
  "editor.selectionBackground": "#ADD6FF",
  "editor.lineHighlightBackground": "#F3F3F3",
  "editorCursor.foreground": "#000000",
  "editorLineNumber.foreground": "#237893",
  "editorLineNumber.activeForeground": "#0B216F",
  "editorWhitespace.foreground": "#BFBFBF",
  "editorIndentGuide.background": "#D3D3D3"
 },
 "settings": [
  {
   "settings": {
    "foreground": "#000000",
    "background": "#FFFFFF"
   }
  },
  {
   "settings": {
    "fontStyle": "italic",
    "foreground": "#008000"
   },
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ]
  },
  {
   "settings": {
    "foreground": "#008000"
   },
   "scope": [
    "comment.line.shebang"
   ]
  },
  {
   "settings": {
    "foreground": "#A31515"
   },
   "scope": [
    "string",
    "string.quoted",
    "string.template"
   ]
  },
  {
   "settings": {
    "foreground": "#EE0000"
   },
   "scope": [
    "constant.character.escape",
    "constant.character.entity",
    "constant.other.placeholder"
   ]
  },
  {
   "settings": {
    "foreground": "#098658"
   },
   "scope": [
    "constant.numeric",
    "constant.other.datetime"
   ]
  },
  {
   "settings": {
    "foreground": "#0000FF"
   },
   "scope": [
    "constant.language",
    "constant.other.color"
   ]
  },
  {
   "settings": {
    "foreground": "#0000FF"
   },
   "scope": [
    "keyword",
    "keyword.control",
    "storage",
    "storage.type",
    "storage.modifier"
   ]
  },
  {
   "settings": {
    "foreground": "#000000"
   },
   "scope": [
    "keyword.operator",
    "punctuation.separator",
    "punctuation.definition.tag"
   ]
  },
  {
   "settings": {
    "foreground": "#795E26"
   },
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call"
   ]
  },
  {
   "settings": {
    "foreground": "#267F99"
   },
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.class",
    "storage.type.primitive"
   ]
  },
  {
   "settings": {
    "foreground": "#795E26"
   },
   "scope": [
    "storage.type.annotation",
    "meta.preprocessor",
    "keyword.other.important",
    "variable.other.anchor",
    "storage.type.tag"
   ]
  },
  {
   "settings": {
    "foreground": "#0000FF"
   },
   "scope": [
    "variable.language",
    "variable.other.template",
    "variable.other.format",
    "variable.css"
   ]
  },
  {
   "settings": {
    "foreground": "#001080"
   },
   "scope": [
    "variable.other",
    "variable.parameter"
   ]
  },
  {
   "settings": {
    "foreground": "#800000"
   },
   "scope": [
    "entity.name.tag",
    "entity.name.section",
    "keyword.control.at-rule"
   ]
  },
  {
   "settings": {
    "foreground": "#E50000"
   },
   "scope": [
    "entity.other.attribute-name",
    "support.type.property-name",
    "variable.parameter.option"
   ]
  },
  {
   "settings": {
    "foreground": "#795E26"
   },
   "scope": [
    "entity.name.label",
    "keyword.control.directive"
   ]
  },
  {
   "settings": {
    "foreground": "#0070C1"
   },
   "scope": [
    "support.constant"
   ]
  },
  {
   "settings": {
    "fontStyle": "bold",
    "foreground": "#0000FF"
   },
   "scope": [
    "markup.heading",
    "markup.heading.setext"
   ]
  },
  {
   "settings": {
    "fontStyle": "bold",
    "foreground": "#000000"
   },
   "scope": [
    "markup.bold"
   ]
  },
  {
   "settings": {
    "fontStyle": "italic",
    "foreground": "#000000"
   },
   "scope": [
    "markup.italic"
   ]
  },
  {
   "settings": {
    "fontStyle": "strikethrough",
    "foreground": "#008000"
   },
   "scope": [
    "markup.strikethrough"
   ]
  },
  {
   "settings": {
    "foreground": "#A31515"
   },
   "scope": [
    "markup.inline.raw",
    "markup.fenced_code"
   ]
  },
  {
   "settings": {
    "fontStyle": "underline",
    "foreground": "#006AB1"
   },
   "scope": [
    "markup.underline.link"
   ]
  },
  {
   "settings": {
    "fontStyle": "italic",
    "foreground": "#008000"
   },
   "scope": [
    "markup.quote"
   ]
  },
  {
   "settings": {
    "foreground": "#0000FF"
   },
   "scope": [
    "punctuation.definition.list",
    "meta.separator"
   ]
  }
 ],
