{
 "name": "xcode-dark",
 "type": "dark",
 "colors": {
  "editor.background": "#1E1F22",
  "editor.foreground": "#BCBEC4",
  "editor.selectionBackground": "#214283",
  "editor.lineHighlightBackground": "#26282E",
  "editorCursor.foreground": "#CED0D6",
  "editorLineNumber.foreground": "#6F737A",
  "editorLineNumber.activeForeground": "#BCBEC4",
  "editorWhitespace.foreground": "#3B3D42",
  "editorIndentGuide.background": "#2E3035"
 },
 "settings": [
  {
   "settings": {
    "foreground": "#BCBEC4",
    "background": "#1E1F22"
   }
  },
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#7A7E85",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "comment.line.shebang"
   ],
   "settings": {
    "foreground": "#7A7E85"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted",
    "string.template"
   ],
   "settings": {
    "foreground": "#6AAB73"
   }
  },
  {
   "scope": [
    "constant.character.escape",
    "constant.character.entity",
    "constant.other.placeholder"
   ],
   "settings": {
    "foreground": "#CF8E6D"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "constant.other.datetime"
   ],
